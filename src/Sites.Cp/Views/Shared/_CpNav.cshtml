@model string?
@{
    var active = Model ?? "";
    var pb = Context.Request.PathBase.Value ?? "";
    var root = string.IsNullOrEmpty(pb) ? "" : (pb.EndsWith("/") ? pb[..^1] : pb);
    string Link(string path) => root + path;
    string NavClass(string tab) => string.Equals(active, tab, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<header>
    <div><strong>Sites CP</strong></div>
    <nav>
        <a href="@Link("/")" class="@NavClass("sites")">Sites</a>
        <a href="@Link("/stats")" class="@NavClass("stats")">Stats</a>
        <a href="@Link("/settings")" class="@NavClass("settings")">Settings</a>
        <a href="@Link("/clone")" class="@NavClass("clone")">Clone</a>
        <a href="@Link("/system")" class="@NavClass("system")">System</a>
    </nav>
    <div style="display:flex; gap:8px; align-items:center">
        <button type="button" id="cpNavRebootBtn">Reboot</button>
        <form method="post" action="@Link("/auth/logout")" style="margin:0">
            <button type="submit" class="secondary">Logout</button>
        </form>
    </div>
</header>
<script>
(function () {
    const btn = document.getElementById("cpNavRebootBtn");
    if (!btn) return;
    btn.addEventListener("click", async () => {
        if (!confirm("Reboot this server now? All sites and CP will stop until the host is back."))
            return;
        btn.disabled = true;
        try {
            const res = await fetch(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Link("/api/system/reboot"))), {
                method: "POST",
                credentials: "same-origin",
                headers: { "Content-Type": "application/json" },
                body: "{}"
            });
            const data = await res.json();
            alert(data.message || (data.succeeded ? "Reboot requested." : "Reboot failed."));
        } catch (e) {
            alert(String(e));
        } finally {
            btn.disabled = false;
        }
    });
})();
</script>
