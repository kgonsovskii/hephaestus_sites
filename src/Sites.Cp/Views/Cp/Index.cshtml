@model Sites.Cp.Models.SitesListPageModel
@{
    var pb = Context.Request.PathBase.Value ?? "";
    var root = string.IsNullOrEmpty(pb) ? "" : (pb.EndsWith("/") ? pb[..^1] : pb);
    string Link(string path) => root + path;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sites CP</title>
    <style>
        :root { font-family: system-ui, sans-serif; color: #1a1a1a; }
        body { margin: 0; background: #f4f5f7; }
        header { background: #111827; color: #fff; padding: 14px 20px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
        header nav a { color: #cbd5e1; text-decoration: none; margin-right: 14px; }
        header nav a.active { color: #fff; font-weight: 600; }
        main { max-width: 1100px; margin: 24px auto; padding: 0 16px 40px; }
        .card { background: #fff; border-radius: 8px; padding: 20px; box-shadow: 0 1px 3px rgba(0,0,0,.08); margin-bottom: 16px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
        th { font-size: 12px; text-transform: uppercase; color: #6b7280; }
        button, .btn { background: #2563eb; color: #fff; border: 0; border-radius: 6px; padding: 8px 12px; cursor: pointer; font: inherit; text-decoration: none; display: inline-block; }
        button.secondary, .btn.secondary { background: #6b7280; }
        button.danger { background: #dc2626; }
        button.git-push { background: #059669; }
        button.git-pull { background: #7c3aed; }
        .badge { display: inline-block; background: #dbeafe; color: #1d4ed8; font-size: 12px; padding: 2px 8px; border-radius: 999px; }
        .badge.warn { background: #fef3c7; color: #92400e; }
        .badge.ok { background: #d1fae5; color: #065f46; }
        .muted { color: #6b7280; font-size: 13px; }
        .actions { display: flex; gap: 8px; flex-wrap: wrap; }
        #status { min-height: 20px; margin-top: 8px; font-size: 13px; }
        #status.error { color: #b91c1c; }
        #status.ok { color: #047857; }
        code { font-size: 12px; background: #f3f4f6; padding: 1px 4px; border-radius: 4px; }
    </style>
</head>
<body>
@await Html.PartialAsync("_CpNav", "sites")
<main>
    <div class="card">
        <div class="actions" style="justify-content:space-between; align-items:center">
            <div>
                <h2 style="margin:0 0 4px">sites.json <span class="badge" style="vertical-align:middle">@Model.Profile</span></h2>
                <div class="muted">@(string.IsNullOrEmpty(Model.Profile) ? "" : $"profile {Model.Profile} · ")@Model.SitesJsonPath</div>
                @if (!string.IsNullOrEmpty(Model.WebFtpUrl))
                {
                    <div class="muted">Web FTP (root <code>@Model.WebRootFullPath</code>): <a href="@Model.WebFtpUrl" class="font-monospace user-select-all">@Model.WebFtpUrl</a></div>
                }
                <div class="muted">Saves apply immediately, reload the site registry, and clear text cache — no restart.</div>
            </div>
            <div class="actions">
                <button type="button" class="secondary" id="clearNonBinaryCacheBtn" title="HTML, JS, CSS, JSON, VBS, CMD, PS1, etc.">Clear text cache</button>
                <button type="button" class="secondary" id="clearCacheBtn">Clear all cache</button>
                <button type="button" class="secondary" id="invalidateBtn">Invalidate</button>
                <a class="btn" href="@Link("/edit")">Add site</a>
            </div>
        </div>
        <div id="status"></div>
    </div>

    <div class="actions" style="margin:0 0 16px">
        <button type="button" class="git-push" id="gitPushBtn" title="git add/commit/push hephaestus_sites_data (profile sites.json, wwwroot)">Push data to git</button>
        <button type="button" class="git-pull" id="gitPullBtn" title="git pull hephaestus_sites_data">Pull data from git</button>
    </div>

    <div class="card">
        <table>
            <thead>
            <tr>
                <th>Target host</th>
                <th>Source host</th>
                <th>Cookies</th>
                <th>Cache</th>
                <th>Module</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var site in Model.Sites)
            {
                <tr>
                    <td><code>@site.TargetHost</code></td>
                    <td><code>@site.SourceHost</code></td>
                    <td>
                        @if (site.PassCookies)
                        {
                            <span class="badge ok">on</span>
                        }
                        else
                        {
                            <span class="badge warn">off</span>
                        }
                    </td>
                    <td>
                        @if (site.DisableCaching)
                        {
                            <span class="badge warn">off</span>
                        }
                        else
                        {
                            <span class="badge ok">on</span>
                        }
                    </td>
                    <td>
                        @if (site.HasCodedModule)
                        {
                            <span class="badge">coded</span>
                        }
                        else
                        {
                            <span class="muted">json</span>
                        }
                    </td>
                    <td class="actions">
                        <a class="btn" href="@Link("/edit?site=" + Uri.EscapeDataString(site.TargetHost))">Edit</a>
                        <button type="button" class="danger" data-delete="@site.TargetHost">Delete</button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</main>
<script>
    const maintenanceBase = '@Context.Request.PathBase/api/maintenance';
    const systemBase = '@Context.Request.PathBase/api/system';
    const apiBase = '@Context.Request.PathBase/api/sites';
    const listUrl = '@Link("/")';
    const statusEl = document.getElementById('status');

    function setStatus(message, kind) {
        statusEl.textContent = message || '';
        statusEl.className = kind || '';
    }

    async function api(url, options) {
        const response = await fetch(url, {
            headers: { 'Content-Type': 'application/json' },
            ...options
        });
        if (!response.ok) {
            let error = response.statusText;
            try {
                const body = await response.json();
                error = body.error || JSON.stringify(body);
            } catch { /* ignored */ }
            throw new Error(error);
        }
        if (response.status === 204) return null;
        return response.json();
    }

    async function deleteSite(targetHost) {
        if (!confirm(`Delete site ${targetHost}?`)) return;
        try {
            await api(`${apiBase}/${encodeURIComponent(targetHost)}`, { method: 'DELETE' });
            window.location = listUrl;
        } catch (err) {
            setStatus(err.message, 'error');
        }
    }

    async function gitRepo(action) {
        const label = action === 'pull' ? 'Pull data from git' : 'Push data to git';
        const pullBtn = document.getElementById('gitPullBtn');
        const pushBtn = document.getElementById('gitPushBtn');
        setStatus(`${label} (all sites)…`);
        pullBtn.disabled = true;
        pushBtn.disabled = true;
        try {
            const result = await api(`${systemBase}/git/${action}`, { method: 'POST', body: '{}' });
            const kind = result.succeeded ? 'ok' : 'error';
            const logTail = Array.isArray(result.log) && result.log.length
                ? ' ' + result.log.slice(-3).join(' · ')
                : '';
            setStatus(`${label} (all sites): ${result.message || ''}${logTail}`.trim(), kind);
            if (action === 'pull' && result.succeeded)
                window.location = listUrl;
        } catch (err) {
            setStatus(`${label} (all sites): ${err.message}`, 'error');
        } finally {
            pullBtn.disabled = false;
            pushBtn.disabled = false;
        }
    }

    async function clearNonBinaryCache() {
        if (!confirm('Clear cached HTML, JS, CSS, JSON, and other non-binary responses for every site? Images, video, and other excluded media stay cached.')) return;
        try {
            const result = await api(`${maintenanceBase}/clear-non-binary-cache`, { method: 'POST', body: '{}' });
            setStatus(`Cleared ${result.removedEntries} text cache entr(ies) at ${result.cacheRoot} (profile ${result.profile}).`, 'ok');
        } catch (err) {
            setStatus(err.message, 'error');
        }
    }

    async function clearCache() {
        if (!confirm('Clear all proxy disk cache for every site (including images and video)?')) return;
        try {
            const result = await api(`${maintenanceBase}/clear-cache`, { method: 'POST', body: '{}' });
            setStatus(`Cleared ${result.removedEntries} cache entr(ies) at ${result.cacheRoot} (profile ${result.profile}).`, 'ok');
        } catch (err) {
            setStatus(err.message, 'error');
        }
    }

    async function invalidateSites() {
        try {
            const result = await api(`${maintenanceBase}/invalidate`, { method: 'POST', body: '{}' });
            setStatus(`Reloaded ${result.siteCount} site(s) from profile ${result.profile}: ${result.sitesJsonPath}.`, 'ok');
            window.location = listUrl;
        } catch (err) {
            setStatus(err.message, 'error');
        }
    }

    document.getElementById('gitPullBtn').addEventListener('click', () => gitRepo('pull'));
    document.getElementById('gitPushBtn').addEventListener('click', () => gitRepo('push'));
    document.getElementById('clearNonBinaryCacheBtn').addEventListener('click', clearNonBinaryCache);
    document.getElementById('clearCacheBtn').addEventListener('click', clearCache);
    document.getElementById('invalidateBtn').addEventListener('click', invalidateSites);
    document.querySelectorAll('[data-delete]').forEach(btn => btn.addEventListener('click', () => deleteSite(btn.dataset.delete)));
</script>
</body>
</html>
